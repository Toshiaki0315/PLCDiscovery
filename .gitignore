# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing / coverage
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Build and distribution
build/
dist/
*.egg-info/

# Virtual environment created by the launchers (start_gui.*, plc_scanner.*)
.venv/

# Scan output written by plc_scanner.py / the GUI (default --output-dir)
plc_scan_results/

# Settings saved by the GUI / the CLI default config: may contain webhook
# URLs (secrets) for Teams/Slack notifications
plc_config.yaml

# SQLite database output (default path), its backups and exports
plc_data.db
plc_data_backup_*.db
plc_db_export_*/

# Logs written with --audit-log / logging.file (README examples)
audit.log
*.log
